# Narration in the author's cloned voice (optional). See docs/voice-narration.md.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: rebuild share pages right after publishing (otherwise every 2 hours).
# Fine-grained GitHub token for this repository, permission "Actions: read and write".
GITHUB_DEPLOY_TOKEN=
