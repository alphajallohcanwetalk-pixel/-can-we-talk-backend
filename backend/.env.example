# Stripe
STRIPE_SECRET_KEY=sk_live_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_BOOKCLUB_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_BOOKCLUB_ANNUAL=price_your-annual-price-id

# Resend
RESEND_API_KEY=re_your-api-key
EMAIL_FROM="Can We Talk <info@canwetalkvoice.com>"

# App
FRONTEND_URL=https://canwetalkvoice.com
FRONTEND_APP_URL=https://canwetalkvoice.com
PORT=4000
ADMIN_EMAIL=alpha.jalloh@canwetalkvoice.com

# App notifications (Web Push). Make a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
